ENV=development
PORT=8080

# --- Database ---
# If unset in development, falls back to sqlite:///./fraudguard.db
# Required in production (app raises RuntimeError at startup if missing).
# Supabase Postgres example:
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?sslmode=require

# --- CORS ---
# Comma-separated explicit allow-list. No wildcard ("*") is accepted —
# the app raises at startup if CORS_ALLOWED_ORIGINS contains "*".
# If unset in development, defaults to http://localhost:3000 only.
# Required (non-empty, no wildcard) in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth ---
# NOTE: the variable name is JWT_SECRET_KEY (not JWT_SECRET) — this file
# previously documented the wrong name, which silently caused a random
# ephemeral secret to be generated in non-production instead of using the
# value an operator thought they had configured. Required in production.
JWT_SECRET_KEY=replace-with-a-strong-random-secret

# --- Encryption at rest ---
# Base64-encoded 32-byte (AES-256) key used to encrypt sensitive JSON
# blobs (transaction features, behavioral events, device fingerprints).
# Required in production — the app refuses to start (fails closed) if this
# is unset while ENV=production, rather than silently storing plaintext.
# Generate one with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FG_AES_KEY=
