    "/health": {
      "get": {
        "description": "Readiness probe: verifies actual dependency connectivity (database)\nrather than only confirming the process is running. Returns 200 with\nstatus \"degraded\" (not a 5xx) when a dependency is unhealthy, so\norchestrator health-check tooling can distinguish \"process crashed\"\nfrom \"process up but a dependency is down\" \u2014 the response body carries\nthe detail either way.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
