    "/v1/fraud/graph": {
      "get": {
        "description": "Builds a user/device/IP relationship graph for investigator tooling\nfrom one page of recent transactions.\n\nAPI-05 FIX: previously used a hardcoded `.limit(GRAPH_MAX_TRANSACTIONS)`\ninstead of this API's shared pagination contract. Now accepts the same\n`page`/`page_size` query parameters as every other list endpoint\n(`/fraud/alerts`, `/admin/audit`, `/admin/users`) via `PageParams`, and\na client pages through transactions (most-recent-first) instead of\nalways receiving one fixed top-N slice.\n\nThis remains a synchronous, request-time computation, intentionally\nscoped to one bounded page for fast interactive use. For the *full*\ngraph across up to GRAPH_JOB_MAX_TRANSACTIONS transactions, use\n`POST /graph/jobs` instead (SCALE-02 background-job path) \u2014 see that\nendpoint's docstring.",
        "operationId": "fraud_graph_v1_fraud_graph_get",
        "parameters": [
          {
            "description": "1-indexed page number",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "1-indexed page number",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Items per page",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 25,
              "description": "Items per page",
              "maximum": 200,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Fraud Graph",
        "tags": [
          "fraud"
        ]
      }
    },
    "/v1/fraud/graph/jobs": {
      "post": {
        "description": "SCALE-02 FIX: computing the *full* fraud-ring graph (as opposed to one\npaginated page \u2014 see GET /graph above) can mean scanning up to\nGRAPH_JOB_MAX_TRANSACTIONS rows and building a networkx graph from all\nof them, which is exactly the kind of work that should not block a\nrequest/response cycle or an API worker. This kicks the computation off\nvia FastAPI's `BackgroundTasks` (chosen over Celery+Redis: this project\nis not otherwise running a message broker, and BackgroundTasks is\nexplicitly the right-sized tool for \"run this after the response, in\nthe same process\" without introducing new infrastructure) and returns\nimmediately with a job id; poll `GET /graph/jobs/{job_id}` for status\nand, once done, the result.",
        "operationId": "create_graph_job_v1_fraud_graph_jobs_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Create Graph Job",
        "tags": [
          "fraud"
        ]
      }
    },
