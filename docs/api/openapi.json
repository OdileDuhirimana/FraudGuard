    "/v1/auth/logout": {
      "post": {
        "description": "AUTH-02 FIX: previously there was no logout endpoint at all, and no\nmechanism to invalidate an access token before its natural 8-hour\nexpiry under any circumstance. This revokes the *specific token\npresented on this request* by recording its `jti` in the server-side\ndenylist (services/tokens.py); get_current_user checks every\nsubsequent request's jti against that table, so the presented token\n(and only that token \u2014 other active sessions/tokens for the same user\nare unaffected, matching standard single-session logout semantics)\nstops working immediately rather than at natural expiry.",
        "operationId": "logout_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
